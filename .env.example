# ============================================================
# Crypto Analytics Platform — .env.example
# Copiá como .env y completá los valores reales.
# NUNCA commitear el archivo .env
# ============================================================

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# --- GCS ---
GCS_BUCKET_RAW=crypto-analytics-raw-dev

# --- BigQuery ---
BQ_DATASET=crypto_analytics
BQ_LOCATION=EU

# --- APIs ---
COINGECKO_API_KEY=your-coingecko-api-key

# --- Airflow ---
AIRFLOW_HOME=/home/user/Projects/crypto-analytics-platform/airflow

# --- Entorno ---
ENVIRONMENT=development
LOG_LEVEL=INFO
